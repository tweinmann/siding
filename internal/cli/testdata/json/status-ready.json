{
  "apiVersion": "siding.dev/v1alpha1",
  "kind": "Status",
  "verdict": "Ready",
  "stack": {
    "project": "shop-main",
    "repo": "shop",
    "branch": "main",
    "worktree": "/src/shop",
    "url": "http://shop.main.localhost/"
  },
  "services": [
    {
      "name": "api",
      "state": "running",
      "route": "/api",
      "url": "http://api.shop.main.localhost/",
