      "ready": true
    },
    {
      "name": "db",
      "state": "running",
      "health": "healthy",
      "ready": true
    },
    {
      "name": "mail",
      "state": "running",
      "url": "http://mail.shop.main.localhost/",
      "ready": true
    },
    {
      "name": "web",
      "state": "running",
      "route": "/",
      "url": "http://web.shop.main.localhost/",
      "answering": true,
      "ready": true
    }
  ]
}
